Bootstrap: docker
From: ubuntu:26.04

%arguments
    APP_DIR=/usr/local/app/lammps
    PYTHON_VENV_DIR=/usr/local/app/lammps/venv

%files
    ../src              {{ APP_DIR }}/src
    ../chemtrain        {{ APP_DIR }}/chemtrain
    ../tensorial        {{ APP_DIR }}/tensorial
    ../cmake            {{ APP_DIR }}/cmake
    ../bash             {{ APP_DIR }}/bash
    ../python           {{ APP_DIR }}/python
    ../requirements.txt {{ APP_DIR }}/requirements.txt

%environment
    export PATH={{ APP_DIR }}/build:$PATH

%post -c /bin/bash
    export DEBIAN_FRONTEND=noninteractive
    
    source {{ APP_DIR }}/bash/utils.bash

    apt-get -o Acquire::Retries=5  update
    apt-get -o Acquire::Retries=5  install --no-install-recommends -y git build-essential wget libopenmpi-dev openmpi-bin curl software-properties-common cmake bat

    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get -o Acquire::Retries=5  update
    apt-get -o Acquire::Retries=5  install -y ${python_version} ${python_version}-venv ${python_version}-dev

    bash {{ APP_DIR }}/bash/setup_python_venv.bash {{ PYTHON_VENV_DIR }} cpu

    source {{ PYTHON_VENV_DIR }}/bin/activate

    cd {{ APP_DIR }}
    mkdir -p build && cd build
    cmake ../cmake --preset=chemtrain
    make -j "$(nproc)"
    
    mv {{ APP_DIR }}/bash/${git_info_file} {{ APP_DIR }}

    {{ APP_DIR }}/bash/clean_apptainer.bash {{ APP_DIR }} {{ PYTHON_VENV_DIR }} 

%runscript
    #!/bin/bash
    cmd="${1:-}"; [ $# -gt 0 ] && shift
    case "$cmd" in
        lmp)    mpirun -np "${NP:-1}" lmp -in "$@" ;;
        export) exec {{ PYTHON_VENV_DIR }}/bin/python {{ APP_DIR }}/python/model-export/export-model.py "$@" ;;
        help)   exec batcat --theme="Monokai Extended" --style=plain {{ APP_DIR }}/bash/help.bash ;;
        *)      echo "Unknown command: $cmd" >&2; exit 1 ;;
    esac
